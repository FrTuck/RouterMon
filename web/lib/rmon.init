#!/bin/sh /etc/rc.common
# RouterMon — служба сбора метрик (каждые 10 с в /tmp/rmon)
START=99
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /bin/sh /etc/rmon-web/lib/collect.sh
  procd_set_param nice 10
  procd_set_param respawn 3600 5 0
  procd_set_param stderr 1
  procd_close_instance
}
